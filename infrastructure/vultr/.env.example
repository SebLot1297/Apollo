# Copy to .env on the authorized inference host. Blank key intentionally prevents startup.
# Generate a private key locally using the README recipe, which never displays it.
# Never commit .env or paste keys, rendered config, container inspection, or request logs into chat.
VLLM_API_KEY=
HF_TOKEN=

# Verified official release tag; runtime fit and exact image/model qualification remain pending.
VLLM_IMAGE=vllm/vllm-openai:v0.28.0-cu129
VLLM_MODEL=Qwen/Qwen3.8-27B
VLLM_MODEL_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
VLLM_HOST_PORT=8001
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=2
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_TENSOR_PARALLEL_SIZE=1
