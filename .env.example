# Local TimescaleDB via npm run db:up; never commit real credentials.
# Copy to .env, then set DATABASE_URL below to use PostgreSQL instead of
# the explicit SQLite LOCAL DEMO default when .env is absent.
DATABASE_URL=postgresql+psycopg://commandgrid:commandgrid_local@127.0.0.1:5433/commandgrid
POSTGRES_USER=commandgrid
POSTGRES_PASSWORD=commandgrid_local
POSTGRES_DB=commandgrid
TIMESCALE_IMAGE=timescale/timescaledb:2.23.1-pg17
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_MODEL=Qwen/Qwen3.8-27B
QWEN_API_KEY=
AI_PRIMARY_PROVIDER=auto
ENABLE_QWEN=false
ENABLE_AI=true
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONCURRENCY=2
AI_REQUESTS_PER_MINUTE=12
AI_HEALTH_CACHE_SECONDS=60
DEMO_MODE=false
SIMULATION_TICK_SECONDS=1
SIMULATION_TIME_MULTIPLIER=30
TELEMETRY_BATCH_SIZE=1000
REQUEST_MAX_BYTES=262144
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
APP_ENV=development
LOG_LEVEL=INFO
# Public deployments need application auth/authorization before shared access.
